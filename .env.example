# Copy this file to .env for local development.
# Do not commit real secrets.

APP_ENV=development
PUBLIC_BASE_URL=
ADMIN_BASE_URL=http://127.0.0.1:8787
ADMIN_API_KEY=
LOG_LEVEL=info

# Meta / Instagram
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_USERNAME=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN_EXPIRES_AT=

# Runtime controls
BOT_ENABLED=false
DM_AUTOREPLY_ENABLED=false

# Comment reply behavior
COMMENT_PRIVATE_REPLY_ENABLED=false
BACKFILL_REPLY_ENABLED=false
COMMENT_PUBLIC_REPLY_ENABLED=false
BACKFILL_PRIVATE_REPLY_MAX_AGE_DAYS=7
BACKFILL_MAX_PAGES_PER_RUN=25
MAX_REPLY_ATTEMPTS=3
RATE_LIMIT_MESSAGES_PER_MINUTE=30
RECONCILER_ENABLED=true
RECONCILER_INTERVAL_MINUTES=10
RECONCILER_MEDIA_LIMIT=10
RECONCILER_MAX_COMMENT_PAGES_PER_MEDIA=3
RECONCILER_LOOKBACK_HOURS=24

# Cloudflare deployment and resource names
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_WORKER_NAME=instagram-bot
CLOUDFLARE_D1_DATABASE_NAME=instagram_bot
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=
CLOUDFLARE_QUEUE_NAME=instagram-bot-jobs
